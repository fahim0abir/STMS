{
  "info": {
    "name": "SmartTask API",
    "description": "SmartTask (STMS) REST API collection. Set `baseUrl` and run Auth > Login to populate `accessToken` and `refreshToken` automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5195" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "projectId", "value": "" },
    { "key": "taskId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/Auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@smarttask.dev\",\n  \"password\": \"NewUser123!\",\n  \"name\": \"New User\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.data) {",
                  "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/Auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@smarttask.dev\",\n  \"password\": \"Admin123!\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/Auth/refresh-token",
            "body": { "mode": "raw", "raw": "\"{{refreshToken}}\"" }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/Auth/logout",
            "body": { "mode": "raw", "raw": "\"{{refreshToken}}\"" }
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "Create Project (Admin, ProjectManager)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.data) { pm.collectionVariables.set('projectId', body.data.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/Projects",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Website Revamp\",\n  \"description\": \"Refresh the marketing site\"\n}"
            }
          }
        },
        {
          "name": "Get Project By Id",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/Projects/{{projectId}}" }
        },
        {
          "name": "Get Projects (Paged)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/Projects/paged?keyword=&sortBy=Name&sortOrder=asc&pageNumber=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Projects", "paged"],
              "query": [
                { "key": "keyword", "value": "" },
                { "key": "sortBy", "value": "Name" },
                { "key": "sortOrder", "value": "asc" },
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Update Project (Admin, ProjectManager)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/Projects/{{projectId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Website Revamp v2\",\n  \"description\": \"Refresh the marketing site and blog\"\n}"
            }
          }
        },
        {
          "name": "Delete Project (Admin)",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/Projects/{{projectId}}" }
        }
      ]
    },
    {
      "name": "TaskItems",
      "item": [
        {
          "name": "Create Task (Admin, ProjectManager)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.data) { pm.collectionVariables.set('taskId', body.data.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/TaskItems",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Draft release notes\",\n  \"description\": \"Summarise changes for v1.0\",\n  \"status\": 0,\n  \"priority\": 1,\n  \"assigneeId\": \"00000000-0000-0000-0000-000000000003\"\n}"
            }
          }
        },
        {
          "name": "Get Task By Id",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/TaskItems/{{taskId}}" }
        },
        {
          "name": "Get Tasks (Paged)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/TaskItems/paged?keyword=&sortBy=CreatedAt&sortOrder=desc&pageNumber=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "TaskItems", "paged"],
              "query": [
                { "key": "keyword", "value": "" },
                { "key": "status", "value": "", "disabled": true },
                { "key": "priority", "value": "", "disabled": true },
                { "key": "assigneeId", "value": "", "disabled": true },
                { "key": "dueFrom", "value": "", "disabled": true },
                { "key": "dueTo", "value": "", "disabled": true },
                { "key": "sortBy", "value": "CreatedAt" },
                { "key": "sortOrder", "value": "desc" },
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get All Tasks",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/TaskItems" }
        },
        {
          "name": "Update Task (Admin, ProjectManager)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/TaskItems/{{taskId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Draft release notes\",\n  \"description\": \"Summarise changes for v1.0\",\n  \"status\": 1,\n  \"priority\": 2,\n  \"assigneeId\": \"00000000-0000-0000-0000-000000000003\"\n}"
            }
          }
        },
        {
          "name": "Delete Task (Admin)",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/TaskItems/{{taskId}}" }
        }
      ]
    },
    {
      "name": "Tasks (AI)",
      "item": [
        {
          "name": "Enhance Description",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/tasks/enhance-description",
            "description": "Rate limited to 10 requests/minute. Description must be 5-1000 characters.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"fix login bug asap users cannot sign in\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Stats",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/dashboard/stats" }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Returns OK when SQL Server is reachable, 503 otherwise."
          }
        }
      ]
    }
  ]
}
