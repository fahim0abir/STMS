{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=SmartTaskDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Database": {
    "RunMigrationsOnStartup": true,
    "RunSeedOnStartup": true
  },
  "Jwt": {
    "Key": "SET_JWT_KEY_IN_USER_SECRETS_MIN_32_CHARACTERS",
    "Issuer": "SmartTask",
    "Audience": "SmartTaskClients"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
