{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=SmartTaskDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Database": {
    "RunMigrationsOnStartup": true,
    "RunSeedOnStartup": true
  },
  "Jwt": {
    "Key": "REPLACE_WITH_USER_SECRETS_JWT_KEY_MIN_32_CHARACTERS",
    "Issuer": "SmartTask",
    "Audience": "SmartTaskClients"
  },
  "AI": {
    "GoogleAIStudio": {
      "ApiKey": "REPLACE_WITH_USER_SECRETS_GOOGLE_AI_STUDIO_KEY",
      "Model": "gemini-3.1-flash-lite",
      "Temperature": "0.4"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
