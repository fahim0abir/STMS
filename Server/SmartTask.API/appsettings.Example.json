{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=SmartTaskDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Database": {
    "RunMigrationsOnStartup": true,
    "RunSeedOnStartup": true
  },
  "Jwt": {
    "Key": "REPLACE_WITH_USER_SECRETS_JWT_KEY_MIN_32_CHARACTERS",
    "Issuer": "SmartTask",
    "Audience": "SmartTaskClients"
  },
  "AI": {
    "GoogleAIStudio": {
      "ApiKey": "REPLACE_WITH_GOOGLE_AI_STUDIO_KEY",
      "Endpoint": "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions",
      "Model": "gemini-2.0-flash",
      "Temperature": "0.4"
    },
    "GitHubModels": {
      "ApiKey": "REPLACE_WITH_GITHUB_MODELS_TOKEN",
      "Endpoint": "https://models.github.ai/inference/chat/completions",
      "Model": "gpt-4o-mini",
      "Temperature": "0.4"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
