{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=SmartTaskDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Database": {
    "RunMigrationsOnStartup": true,
    "RunSeedOnStartup": true
  },
  "Jwt": {
    "Key": "REPLACE_WITH_USER_SECRETS_JWT_KEY_MIN_32_CHARACTERS",
    "Issuer": "SmartTask",
    "Audience": "SmartTaskClients"
  },
  "AI": {
    "GitHubModels": {
      "ApiKey": "REPLACE_WITH_GITHUB_MODELS_TOKEN",
      "Endpoint": "https://models.inference.ai.azure.com/chat/completions",
      "Model": "gpt-4o-mini",
      "Temperature": "0.4"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
